# Copy this file to .env and fill in values as needed.

# Optional: enable a real LLM instead of the offline mock provider.
# If left unset, the app automatically falls back to the deterministic mock AI.
ADR_AI_PROVIDER=mock
ADR_LLM_API_KEY=
ADR_AI_MODEL=claude-sonnet-4-6

# Optional: override default SQLite/config file locations.
ADR_DB_PATH=./data/adr.db
ADR_CONFIG_PATH=./data/config.json
